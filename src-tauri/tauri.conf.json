{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Open Browser",
  "version": "0.1.0",
  "identifier": "com.openbrowser.app",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Browser",
        "width": 1380,
        "height": 900,
        "minWidth": 800,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
